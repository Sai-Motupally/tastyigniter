APP_NAME="TastyIgniter"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DATABASE_URL=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# TastyIgniter Setup (used with --no-interaction)
IGNITER_ADMIN_NAME=Admin
IGNITER_ADMIN_EMAIL=admin@example.com
IGNITER_ADMIN_PASSWORD=admin123
IGNITER_SITE_NAME="My Restaurant"
IGNITER_SITE_URL=${APP_URL}
